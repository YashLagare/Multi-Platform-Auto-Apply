# ==============================================================================
#  WELLFOUND AUTO-APPLY CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#  Copy this file to ".env" and fill in your real details.
#  The .env file is git-ignored, so your personal data is never committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identity & Contact Information
# ------------------------------------------------------------------------------
NAME=Your Full Name
EMAIL=your.email@example.com
PHONE=+91 9999999999
LOCATION=City, Country

# ------------------------------------------------------------------------------
# 2. Professional Profile & Experience
# ------------------------------------------------------------------------------
CURRENT_ROLE=Full Stack Developer at YourCompany (City)
COMPANY=YourCompany
EDUCATION=Degree Name, University Name (2020-2024)
YEARS_EXPERIENCE=3 years
SKILLS=JavaScript, TypeScript, Python, React, Next.js, Node.js, Express, MongoDB, PostgreSQL, Docker, AWS

# Up to 5 resume highlights / accomplishments, separated by "||"
# These are used to generate custom paragraphs in cover letters and answer project questions.
HIGHLIGHTS=First key achievement with impact/metrics||Second major technical achievement||Third achievement or leadership role||Fourth accomplishment||Fifth accomplishment

# ------------------------------------------------------------------------------
# 3. Application Questions & Preferences
# ------------------------------------------------------------------------------
NOTICE_PERIOD=30 days
CURRENT_CTC=12
EXPECTED_CTC=20
DOB=01/01/1998
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence. Open to relocation.

# ------------------------------------------------------------------------------
# 4. Links & Profiles
# ------------------------------------------------------------------------------
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# ------------------------------------------------------------------------------
# 5. Optional: AI Assistant for Custom Questions
# ------------------------------------------------------------------------------
# Free Google Gemini API Key from https://aistudio.google.com/
# If provided, any question the built-in answer bank doesn't match gets answered by Gemini using your CV context.
GEMINI_KEY=
