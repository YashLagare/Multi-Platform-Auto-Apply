# ==============================================================================
#  MULTI-PLATFORM AUTO-APPLY SUITE CONFIGURATION (.env.example)
#  Powers: Wellfound (wellfound.com), Instahyre (instahyre.com), Foundit (foundit.in)
# ==============================================================================
#  Copy this file to ".env" and fill in your real details.
#  The .env file is git-ignored, so your personal data is never committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identity & Contact Information
# ------------------------------------------------------------------------------
NAME=Your Full Name
EMAIL=your.email@example.com
PHONE=+91 9999999999
LOCATION=City, State, Country

# ------------------------------------------------------------------------------
# 2. Professional Profile & Experience
# ------------------------------------------------------------------------------
PROFILE_HEADLINE=Frontend-focused Full Stack Developer | React.js, Next.js, TypeScript, Node.js
PROFILE_SUMMARY=Frontend-focused developer with production React/Next.js experience, REST API integration, and full-stack SaaS projects.
CURRENT_ROLE=Frontend-focused Full Stack Developer
COMPANY=
EDUCATION=Degree Name, University Name (2020-2024), CGPA X.X
EXPERIENCE_YEARS_NUMERIC=1
EXPERIENCE_SUMMARY=Enter accurate professional experience and relevant project experience; keep internship and full-time experience distinct.
SKILLS=React.js, Next.js, TypeScript, JavaScript, Tailwind CSS, Node.js, Express.js, MongoDB, PostgreSQL, REST APIs, Prisma, Drizzle ORM, Git, GitHub

# Up to 5 factual resume highlights, separated by "||". Do not add unsupported claims.
HIGHLIGHTS=First measurable work achievement||Second technical achievement||Most relevant project achievement||Second relevant project achievement||Additional project achievement

# ------------------------------------------------------------------------------
# 3. Application Questions & Preferences
# ------------------------------------------------------------------------------
NOTICE_PERIOD=
CURRENT_CTC=
EXPECTED_CTC=
DOB=
GENDER=
WORK_AUTH=

# ------------------------------------------------------------------------------
# 4. Links & Profiles
# ------------------------------------------------------------------------------
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# ------------------------------------------------------------------------------
# 5. Optional: AI Assistant for Custom Screening Questions
# ------------------------------------------------------------------------------
# Free Google Gemini API Key from https://aistudio.google.com/
# If provided, any custom recruiter questions on Wellfound, Instahyre, or Foundit that aren't
# in the built-in QA bank will be answered dynamically by Gemini using your CV context.
GEMINI_KEY=
