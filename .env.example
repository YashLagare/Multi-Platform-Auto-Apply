# ==============================================================================
#  MULTI-PLATFORM AUTO-APPLY SUITE CONFIGURATION (.env.example)
#  Powers: Wellfound (wellfound.com), Instahyre (instahyre.com), Foundit (foundit.in)
# ==============================================================================
#  Copy this file to ".env" and fill in your real details.
#  The .env file is git-ignored, so your personal data is never committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identity & Contact Information
# ------------------------------------------------------------------------------
NAME=Your Full Name
EMAIL=your.email@example.com
PHONE=+91 9999999999
LOCATION=City, State, Country

# ------------------------------------------------------------------------------
# 2. Professional Profile & Experience
# ------------------------------------------------------------------------------
CURRENT_ROLE=Full Stack Developer
COMPANY=YourCompany
EDUCATION=Degree Name, University Name (2020-2024), CGPA X.X
YEARS_EXPERIENCE=X years professional experience + X full-stack projects
SKILLS=React.js, Next.js, TypeScript, JavaScript, Node.js, Express.js, MongoDB, PostgreSQL, Tailwind CSS, REST APIs, Git, GitHub

# Up to 5 resume highlights / accomplishments, separated by "||"
# These are used to generate custom paragraphs in cover letters, pitches, and answer project questions.
HIGHLIGHTS=First key achievement with impact/metrics||Second major technical achievement||Third achievement or SaaS project||Fourth accomplishment||Fifth accomplishment

# ------------------------------------------------------------------------------
# 3. Application Questions & Preferences
# ------------------------------------------------------------------------------
NOTICE_PERIOD=Immediately available
CURRENT_CTC=3LPA
EXPECTED_CTC=4.5LPA
DOB=01/01/2000
GENDER=Male
WORK_AUTH=Authorized to work in India. Open to relocation and remote work.

# ------------------------------------------------------------------------------
# 4. Links & Profiles
# ------------------------------------------------------------------------------
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# ------------------------------------------------------------------------------
# 5. Optional: AI Assistant for Custom Screening Questions
# ------------------------------------------------------------------------------
# Free Google Gemini API Key from https://aistudio.google.com/
# If provided, any custom recruiter questions on Wellfound, Instahyre, or Foundit that aren't
# in the built-in QA bank will be answered dynamically by Gemini using your CV context.
GEMINI_KEY=
